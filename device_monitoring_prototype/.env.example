SECRET_KEY=replace-with-a-long-random-secret
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=devmonitor
MYSQL_USER=root
MYSQL_PASSWORD=
# XAMPP commonly uses root without a password on a local development install.
COOKIE_SECURE=false
